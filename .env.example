# Dapatkan dari dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# "true" hanya setelah akun Midtrans Production disetujui
MIDTRANS_IS_PRODUCTION=false
# Opsional: alamat situs, dipakai untuk halaman kembali setelah bayar
PUBLIC_BASE_URL=https://tarot.highersoul.id

# Meta (Facebook/Instagram) — Pixel di browser + Conversions API di server.
# Purchase HANYA dikirim server setelah Midtrans mengonfirmasi lunas.
# Events Manager → Data sources → (Pixel) → Settings
META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token (RAHASIA)
META_CAPI_TOKEN=
# Opsional, untuk uji coba di tab "Test events"; kosongkan saat iklan berjalan
META_TEST_EVENT_CODE=
